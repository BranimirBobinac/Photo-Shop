@model WebApp.Models.Photographer
@{ ViewData["Title"] = "Obriši fotografa"; }
<div class="row justify-content-center"><div class="col-md-5">
<div class="card border-warn shadow">
    <div class="card-header bg-warn text-white"><h5 class="mb-0">🗑️ Potvrda brisanja</h5></div>
    <div class="card-body text-center p-4">
        <h5>@Model.Name</h5>
        <p class="text-muted">Jeste li sigurni da želite obrisati ovog fotografa?</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-warn">Da, obriši</button>
            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
        </form>
    </div>
</div>
</div></div>
