@model WebApp.Models.Photo
@{ ViewData["Title"] = "Obriši fotografiju"; }
<div class="row justify-content-center"><div class="col-md-6">
<div class="card border-warn shadow">
    <div class="card-header bg-warn text-white"><h5 class="mb-0">🗑️ Potvrda brisanja</h5></div>
    <div class="card-body text-center p-4">
        <img src="@Model.ImageUrl" style="max-width:100%;max-height:200px;object-fit:cover;border-radius:8px;" class="mb-3" onerror="this.style.display='none'" />
        <h5>@Model.Name</h5>
        <p class="text-muted">Jeste li sigurni da želite obrisati ovu fotografiju?</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-warn">Da, obriši</button>
            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
        </form>
    </div>
</div>
</div></div>
