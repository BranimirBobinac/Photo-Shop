@model List<WebApp.Models.AppUser>
@{ ViewData["Title"] = "Korisnici i preuzimanja"; }
<h2 class="mb-4">👥 Korisnici i njihova preuzimanja</h2>
@foreach (var user in Model)
{
    <div class="card mb-3 shadow-sm">
        <div class="card-header bg-slate d-flex justify-content-between">
            <span>👤 @user.Username (@user.Email)</span>
            <span class="badge bg-brand">@user.Downloads.Count preuzimanja</span>
        </div>
        @if (user.Downloads.Any())
        {
            <div class="card-body">
                <div class="row row-cols-2 row-cols-md-6 g-2">
                    @foreach (var dl in user.Downloads)
                    {
                        <div class="col text-center">
                            <img src="@dl.Photo?.ImageUrl" style="width:100%;height:70px;object-fit:cover;border-radius:6px;" onerror="this.style.display='none'" />
                            <small class="d-block text-muted">@dl.Photo?.Name</small>
                            <small class="text-muted">@dl.DownloadedAt.ToString("dd.MM.yy")</small>
                        </div>
                    }
                </div>
            </div>
        }
        else { <div class="card-body text-muted">Nema preuzimanja.</div> }
    </div>
}
