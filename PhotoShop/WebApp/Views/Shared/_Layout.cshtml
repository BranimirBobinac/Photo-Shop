<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhotoShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/theme.css" rel="stylesheet" />
    <style>
        .navbar-brand { font-weight: bold; font-size: 1.4rem; }
        .photo-card { transition: transform 0.2s; cursor: pointer; }
        .photo-card:hover { transform: translateY(-4px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
        .photo-card img { height: 200px; object-fit: cover; }
        .tag-badge { background: #3a8f85; color: white; font-size: 0.75rem; }
        footer { background: #22313f; color: #b8c4cc; padding: 20px 0; margin-top: 40px; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-lg navbar-dark" style="background:#22313f;">
            <div class="container">
                <a class="navbar-brand" href="/">📷 PhotoShop</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Photo" asp-action="Index">Fotografije</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Photographer" asp-action="Index">Fotografi</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Tag" asp-action="Index">Oznake</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Photo" asp-action="UserDownloads">Korisnici</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Photo" asp-action="Browse">Fotografije</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">👤 Profil</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Odjava</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    }
    <main class="container mt-4">
        @RenderBody()
    </main>
    <footer class="text-center">
        <div class="container"><p class="mb-0">© 2026 PhotoShop — Platforma za prodaju fotografija</p></div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
